#!/usr/bin/python3
"""Root helper for gopro-sync: manages the systemd mount unit for the NAS share.

Invoked via `sudo -n` by the unprivileged gopro-sync service (sudoers allows only this file).
Commands:
    apply    read JSON settings from stdin, write the unit (+ SMB credentials), enable and (re)mount
    mount    start the mount unit
    unmount  stop the mount unit
    remove   stop, disable and delete the unit and credentials
    status   print JSON status
Only the fixed mount point below is ever touched and all inputs are validated.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path

MOUNT_POINT = Path("/mnt/gopronas")
UNIT_NAME = "mnt-gopronas.mount"
UNIT_PATH = Path("/etc/systemd/system") / UNIT_NAME
SECRETS_DIR = Path("/etc/gopro-sync-mount")
SMB_CREDENTIALS = SECRETS_DIR / "smb-credentials"

RE_SERVER = re.compile(r"^[A-Za-z0-9.\-]+$|^\[?[0-9A-Fa-f:]+\]?$")
RE_SMB_SHARE = re.compile(r"^[A-Za-z0-9._$\-]+(/[A-Za-z0-9._\-]+)*$")
RE_NFS_EXPORT = re.compile(r"^/[A-Za-z0-9._\-/]*$")
RE_USER = re.compile(r"^[A-Za-z0-9._@\-]{1,64}$")
SMB_VERSIONS = {"", "1.0", "2.0", "2.1", "3", "3.0", "3.02", "3.1.1"}
NFS_VERSIONS = {"", "3", "4", "4.0", "4.1", "4.2"}


class ValidationError(ValueError):
    pass


def validate(settings: dict) -> dict:
    kind = settings.get("type")
    server = str(settings.get("server", ""))
    share = str(settings.get("share", "")).strip("/") if kind == "smb" else str(settings.get("share", ""))
    version = str(settings.get("version", ""))
    if kind not in ("smb", "nfs"):
        raise ValidationError("type must be smb or nfs")
    if not RE_SERVER.match(server):
        raise ValidationError("invalid server name")
    out = {"type": kind, "server": server.strip("[]"), "share": share, "version": version}
    if kind == "smb":
        if not RE_SMB_SHARE.match(share):
            raise ValidationError("invalid SMB share (letters, digits, . _ - $ and / only)")
        if version not in SMB_VERSIONS:
            raise ValidationError("invalid SMB version")
        username = str(settings.get("username", ""))
        domain = str(settings.get("domain", ""))
        if username and not RE_USER.match(username):
            raise ValidationError("invalid username")
        if domain and not RE_USER.match(domain):
            raise ValidationError("invalid domain")
        password = settings.get("password")
        if password is not None and ("\n" in str(password) or "\r" in str(password)):
            raise ValidationError("password must not contain line breaks")
        out.update(username=username, domain=domain, password=password)
    else:
        if not RE_NFS_EXPORT.match(share):
            raise ValidationError("invalid NFS export path")
        if version not in NFS_VERSIONS:
            raise ValidationError("invalid NFS version")
    return out


def render_unit(settings: dict, uid: int, gid: int) -> str:
    server = settings["server"]
    if ":" in server:  # IPv6 literal
        server = f"[{server}]"
    if settings["type"] == "smb":
        what = f"//{server}/{settings['share']}"
        fstype = "cifs"
        opts = [
            f"credentials={SMB_CREDENTIALS}",
            f"uid={uid}", f"gid={gid}", "file_mode=0664", "dir_mode=0775", "iocharset=utf8",
        ]
        if settings["version"]:
            opts.append(f"vers={settings['version']}")
    else:
        what = f"{server}:{settings['share']}"
        fstype = "nfs"
        opts = ["hard", "timeo=600", "retrans=3"]
        if settings["version"]:
            opts.append(f"nfsvers={settings['version']}")
    opts += ["_netdev", "nofail", "x-systemd.mount-timeout=30"]
    return (
        "# Generated by gopro-sync-mount. Do not edit; use the gopro-sync web UI.\n"
        "[Unit]\n"
        "Description=gopro-sync NAS share\n"
        "Wants=network-online.target\n"
        "After=network-online.target\n"
        "\n"
        "[Mount]\n"
        f"What={what}\n"
        f"Where={MOUNT_POINT}\n"
        f"Type={fstype}\n"
        f"Options={','.join(opts)}\n"
        "TimeoutSec=45\n"
        "\n"
        "[Install]\n"
        "WantedBy=remote-fs.target\n"
    )


def render_credentials(settings: dict, password: str) -> str:
    lines = [f"username={settings['username']}", f"password={password}"]
    if settings["domain"]:
        lines.append(f"domain={settings['domain']}")
    return "\n".join(lines) + "\n"


def systemctl(*args: str, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(["systemctl", *args], capture_output=True, text=True, check=check)


def write_private(path: Path, content: str, mode: int) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w") as fp:
        fp.write(content)
    os.replace(tmp, path)


def cmd_apply() -> dict:
    settings = validate(json.load(sys.stdin))
    uid = int(os.environ.get("SUDO_UID", "0"))
    gid = int(os.environ.get("SUDO_GID", "0"))
    if settings["type"] == "smb":
        password = settings.get("password")
        if password is None:
            # Keep the stored password, but rewrite the username / domain
            existing = SMB_CREDENTIALS.read_text() if SMB_CREDENTIALS.exists() else ""
            password = next((l[9:] for l in existing.splitlines() if l.startswith("password=")), "")
        write_private(SMB_CREDENTIALS, render_credentials(settings, password), 0o600)
    elif SMB_CREDENTIALS.exists():
        SMB_CREDENTIALS.unlink()
    MOUNT_POINT.mkdir(parents=True, exist_ok=True)
    systemctl("stop", UNIT_NAME, check=False)
    write_private(UNIT_PATH, render_unit(settings, uid, gid), 0o644)
    systemctl("daemon-reload")
    systemctl("enable", UNIT_NAME)
    return cmd_mount()


def cmd_mount() -> dict:
    proc = systemctl("start", UNIT_NAME, check=False)
    status = cmd_status()
    if proc.returncode != 0:
        status["error"] = (proc.stderr.strip() or "mount failed") + journal_tail()
    return status


def journal_tail() -> str:
    proc = subprocess.run(
        ["journalctl", "-u", UNIT_NAME, "-n", "5", "--no-pager", "-o", "cat"], capture_output=True, text=True
    )
    return ("\n" + proc.stdout.strip()) if proc.stdout.strip() else ""


def cmd_unmount() -> dict:
    systemctl("stop", UNIT_NAME, check=False)
    return cmd_status()


def cmd_remove() -> dict:
    systemctl("stop", UNIT_NAME, check=False)
    systemctl("disable", UNIT_NAME, check=False)
    for path in (UNIT_PATH, SMB_CREDENTIALS):
        if path.exists():
            path.unlink()
    systemctl("daemon-reload", check=False)
    return cmd_status()


def cmd_status() -> dict:
    active = systemctl("is-active", UNIT_NAME, check=False).stdout.strip()
    return {"unit": UNIT_NAME, "configured": UNIT_PATH.exists(), "active": active, "mounted": os.path.ismount(MOUNT_POINT)}


COMMANDS = {"apply": cmd_apply, "mount": cmd_mount, "unmount": cmd_unmount, "remove": cmd_remove, "status": cmd_status}


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in COMMANDS:
        print(json.dumps({"error": f"usage: {Path(sys.argv[0]).name} {'|'.join(COMMANDS)}"}))
        return 2
    if os.geteuid() != 0:
        print(json.dumps({"error": "must run as root"}))
        return 1
    try:
        result = COMMANDS[sys.argv[1]]()
    except (ValidationError, json.JSONDecodeError) as e:
        print(json.dumps({"error": str(e)}))
        return 1
    except subprocess.CalledProcessError as e:
        print(json.dumps({"error": (e.stderr or str(e)).strip()}))
        return 1
    print(json.dumps(result))
    return 0 if "error" not in result else 1


if __name__ == "__main__":
    sys.exit(main())
